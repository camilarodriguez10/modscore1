<Project>

  <PropertyGroup>
    <!-- Una sola version por paquete en toda la solucion (plan secc. 7.1). -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.3" />

    <!-- Pin transitivo de seguridad: Microsoft.AspNetCore.OpenApi 10.0.3 arrastra
         Microsoft.OpenApi 2.0.0, con GHSA-v5pm-xwqc-g5wc (severidad alta).
         El escaneo de NuGet lo detecto y rompio el build, como debe. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="9.10.0" />

    <!-- Validacion del token de servicio como JWT (ADR 0020, opcion C). Una sola version de
         IdentityModel en toda la solucion: la 8.22.0 desde el 2026-10-21, porque
         Microsoft.Data.SqlClient 7.1.1 exige al menos la 8.16.0 (ADR 0037). -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup Label="Fuentes de datos">
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <!-- Conectores de solo lectura a las bases de las fuentes (ADR 0037). Versiones estables sin
         vulnerabilidades conocidas al 2026-10-21; NuGetAudit corta la restauración si aparece una. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.1" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" />
    <PackageVersion Include="System.Data.Odbc" Version="10.0.12" />
    <!-- Transitiva de SqlClient y de ODP.NET: la 9.0.18 que traen tiene GHSA-846f-f764-76mx (alta)
         y GHSA-2fmv-rv2c-59x7 (moderada). Se fija en la primera corregida. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

</Project>
