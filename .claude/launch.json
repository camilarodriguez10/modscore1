{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "system",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run", "--project", "src/system/Modernization.SystemApi", "--no-launch-profile", "-p:UseAppHost=false",
        "-e", "ASPNETCORE_ENVIRONMENT=Development",
        "-e", "ASPNETCORE_URLS=http://localhost:5101",
        "-e", "DataSource__Provider=File",
        "-e", "DataSource__Directory=../../../data/local"
      ],
      "port": 5101
    },
    {
      "name": "channel",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run", "--project", "src/channel/Modernization.ChannelApi", "--no-launch-profile", "-p:UseAppHost=false",
        "-e", "ASPNETCORE_ENVIRONMENT=Development",
        "-e", "ASPNETCORE_URLS=http://localhost:5100"
      ],
      "port": 5100
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "src/web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "system-dummy",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run", "--no-build", "--project", "src/system/Modernization.SystemApi", "--no-launch-profile", "-p:UseAppHost=false",
        "-e", "ASPNETCORE_ENVIRONMENT=Development",
        "-e", "ASPNETCORE_URLS=http://localhost:5101"
      ],
      "port": 5101
    },
    {
      "name": "sitio",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run", "--no-build", "--project", "src/channel/Modernization.ChannelApi", "--no-launch-profile", "-p:UseAppHost=false",
        "-e", "ASPNETCORE_ENVIRONMENT=Development",
        "-e", "ASPNETCORE_URLS=http://localhost:5100",
        "-e", "ASPNETCORE_WEBROOT=../../../sitio-compilado"
      ],
      "port": 5100
    }
  ]
}
