{
  "version": "v1",
  "description": "Column contracts for each source file, transcribed from the real exports. The file adapter validates against them before reading a single row: a missing or renamed column fails with an actionable error instead of producing a silently wrong score.",

  "files": [
    {
      "source": "EAI Master",
      "fileName": "eai_master.csv",
      "keyColumn": "EAI_Code",
      "uniqueKey": true,
      "description": "EAI inventory export. It is the backbone of the portfolio: an application that is not here does not exist.",
      "columns": [
        { "name": "EAI_Code", "type": "code", "required": true, "aliases": ["EAI", "EAI Code", "EAI_CODE"] },
        { "name": "APP_ID", "type": "code", "required": false, "aliases": ["App_Id", "Application ID"] },
        { "name": "Application_Name", "type": "string", "required": false, "aliases": ["Application Name"] },
        { "name": "Application Status", "type": "string", "required": false, "aliases": ["Application_Status"] },
        { "name": "Application_Disposition", "type": "string", "required": false, "aliases": ["Application Disposition", "Disposition"] },
        { "name": "Roadmap", "type": "string", "required": false },
        { "name": "CIO", "type": "string", "required": false },
        { "name": "CRE", "type": "string", "required": false, "aliases": ["CRE, AD Director"] },
        { "name": "LOB", "type": "string", "required": false },
        { "name": "SUB_LOB", "type": "string", "required": false, "aliases": ["Sub-LoB", "Sub_LOB"] },
        { "name": "Region Name", "type": "string", "required": false, "aliases": ["Region", "Region_Name"] },
        { "name": "Country Name", "type": "string", "required": false, "aliases": ["Country", "Country_Name"] },
        { "name": "Critical Application Indicator", "type": "string", "required": false, "aliases": ["Critical_Application_Indicator", "Critical App"] },
        { "name": "Internet_Facing", "type": "string", "required": false, "aliases": ["Internet Facing"] },
        { "name": "Cloud_Indicator", "type": "string", "required": false, "aliases": ["Cloud Indicator"] },
        { "name": "Cloud_Type", "type": "string", "required": false, "aliases": ["Cloud Type"] },
        { "name": "Cloud_Vendor", "type": "string", "required": false, "aliases": ["Cloud Vendor"] },
        { "name": "Coding_Language", "type": "string", "required": false, "aliases": ["Coding Language", "Primary Language"] },
        { "name": "DR_In_Scope", "type": "string", "required": false, "aliases": ["DR In-Scope", "DR In Scope"] },
        { "name": "Does this Application Utilize MFA?", "type": "string", "required": false, "aliases": ["MFA", "Utilizes MFA"] },
        { "name": "Primary_Business_Capability", "type": "string", "required": false, "aliases": ["Primary Business Capability"] },
        { "name": "L1_Business_Capability_Count", "type": "int", "required": false, "aliases": ["L1 Business Capability Count", "Suma de L1_Business_Capability_Count"] },
        { "name": "Recovery_Point_Objective_Range", "type": "string", "required": false, "aliases": ["Recovery Point Objective Range", "RPO"] },
        { "name": "Recovery_Time_Objective_Range", "type": "string", "required": false, "aliases": ["Recovery Time Objective Range", "RTO"] },
        { "name": "User Count", "type": "int", "required": false, "aliases": ["User_Count", "Suma de User Count", "Users"] },
        { "name": "Kenna_Score", "type": "int", "required": false, "aliases": ["Kenna Score", "Suma de Kenna_Score"] },
        { "name": "Raw_Tech_Score", "type": "decimal", "required": false, "aliases": ["Raw Tech Score", "Suma de Raw_Tech_Score"] },
        { "name": "Operational_Score", "type": "decimal", "required": false, "aliases": ["Operational Score", "Suma de Operational_Score"] }
      ]
    },
    {
      "source": "Architectural Value",
      "fileName": "architectural_value_by_eai.csv",
      "keyColumn": "EAI_CODE",
      "description": "Architectural composition per application, exported from CMT.",
      "columns": [
        { "name": "EAI_CODE", "type": "code", "required": true, "aliases": ["EAI_Code", "EAI Code", "EAI"] },
        { "name": "Modern_Count", "type": "int", "required": false, "aliases": ["Modern Count"] },
        { "name": "Heritage_Count", "type": "int", "required": false, "aliases": ["Heritage Count"] },
        { "name": "Obsolete_Count", "type": "int", "required": false, "aliases": ["Obsolete Count"] },
        { "name": "Not_Approved_for_Use_Count", "type": "int", "required": false, "aliases": ["Not Approved for Use Count", "Not_Approved_For_Use_Count"] }
      ]
    },
    {
      "source": "Product Strategy",
      "fileName": "product_strategy.csv",
      "keyColumn": "EAI_CODE",
      "description": "Product count by strategy, exported from MTS.",
      "columns": [
        { "name": "EAI_CODE", "type": "code", "required": true, "aliases": ["EAI_Code", "EAI Code", "EAI"] },
        { "name": "Eliminate_Count", "type": "int", "required": false, "aliases": ["Suma de Eliminate_Count", "Eliminate Count"] },
        { "name": "Invest_Count", "type": "int", "required": false, "aliases": ["Suma de Invest_Count", "Invest Count"] },
        { "name": "Migrate_Count", "type": "int", "required": false, "aliases": ["Suma de Migrate_Count", "Migrate Count"] },
        { "name": "Tolerate_Count", "type": "int", "required": false, "aliases": ["Suma de Tolerate_Count", "Tolerate Count"] }
      ]
    },
    {
      "source": "Tech Debt",
      "fileName": "tech_debt.csv",
      "keyColumn": "APP_ID",
      "description": "Technical debt by APP_ID, not by EAI. The assembler resolves the mapping.",
      "columns": [
        { "name": "APP_ID", "type": "code", "required": true, "aliases": ["App_Id", "Application ID"] },
        { "name": "COMBINED_DENIAL_SCORE", "type": "decimal", "required": false },
        { "name": "COMBINED_ACCEPTED_SCORE", "type": "decimal", "required": false },
        { "name": "COMBINED_APP_SCORE", "type": "decimal", "required": false },
        { "name": "LAST_UPDATED_DATE", "type": "datetime", "required": false }
      ]
    },
    {
      "source": "SCA Flaws",
      "fileName": "veracode_sca_open_flaws.csv",
      "keyColumn": "EAI_CD",
      "description": "One row per vulnerability. An application present here is considered scanned; an absent one is not (ADR 0003).",
      "columns": [
        { "name": "FLAW_IDX_NUM", "type": "long", "required": true },
        { "name": "APP_NM", "type": "string", "required": false },
        { "name": "EAI_CD", "type": "code", "required": true, "aliases": ["EAI_CODE", "EAI"] },
        { "name": "APP_ID", "type": "code", "required": false },
        { "name": "SVR_DSC", "type": "string", "required": true, "aliases": ["SVR_DSCR", "Severity", "SEVERITY_DESC"] },
        { "name": "FND_STT", "type": "string", "required": true, "aliases": ["FND_STTS_DSCR", "Finding Status", "STATUS"] },
        { "name": "FRST_FND_DT", "type": "datetime", "required": false },
        { "name": "LST_FND_DT", "type": "datetime", "required": false },
        { "name": "RSLV_DT", "type": "datetime", "required": false },
        { "name": "FND_AGE", "type": "int", "required": false, "aliases": ["FND_AGE_DSCR"] },
        { "name": "SCAN_TY", "type": "string", "required": false, "aliases": ["SCAN_TYP_DSCR"] },
        { "name": "ROPEN_F", "type": "string", "required": false, "aliases": ["ROPEN_FND_DSCR"] },
        { "name": "CVE_ID", "type": "string", "required": false },
        { "name": "CVSSV3_SCR", "type": "decimal", "required": false, "aliases": ["CVSSV3_SCOR"] },
        { "name": "VUL_NM", "type": "string", "required": false },
        { "name": "LIB_NM", "type": "string", "required": false },
        { "name": "LIB_VND", "type": "string", "required": false, "aliases": ["LIB_VND_NM"] },
        { "name": "PUB_DT", "type": "datetime", "required": false },
        { "name": "ACCSBLT", "type": "string", "required": false, "aliases": ["ACCSBLTY_DSCR"] }
      ]
    },
    {
      "source": "OSS Score",
      "fileName": "oss_score_by_eai.csv",
      "keyColumn": "EAI Code",
      "description": "Open-Source Score per application, exported from the Risk Profile Tool.",
      "columns": [
        { "name": "EAI Code", "type": "code", "required": true, "aliases": ["EAI_CODE", "EAI_Code", "EAI"] },
        { "name": "OSS Score", "type": "decimal", "required": false, "aliases": ["OSS_Score"] },
        { "name": "OPEN_SRC_SFTWR_HLTH_SCOR_UPDT_TS", "type": "datetime", "required": false }
      ]
    },
    {
      "source": "Monitoring",
      "fileName": "monitoreo.csv",
      "keyColumn": "EAI",
      "description": "Monitoring capabilities per application. Booleans as TRUE/FALSE.",
      "columns": [
        { "name": "EAI", "type": "code", "required": true, "aliases": ["EAI_CODE", "EAI Code"] },
        { "name": "Agent", "type": "bool", "required": false },
        { "name": "APM", "type": "bool", "required": false },
        { "name": "Monitoring", "type": "bool", "required": false },
        { "name": "Synthetics", "type": "bool", "required": false }
      ]
    },
    {
      "source": "APIM Onboarding",
      "fileName": "apim_onboarded_eais.csv",
      "keyColumn": "EAI",
      "description": "Applications onboarded to API management. Without a row, exposure has no data.",
      "columns": [
        { "name": "EAI", "type": "code", "required": true, "aliases": ["EAI_CODE", "EAI Code"] },
        { "name": "Country", "type": "string", "required": false },
        { "name": "Application Short Name", "type": "string", "required": false, "aliases": ["Application_Short_Name"] },
        { "name": "Application Name", "type": "string", "required": false, "aliases": ["Application_Name"] },
        { "name": "API Type", "type": "string", "required": false, "aliases": ["API_Type", "ApiType"] }
      ]
    }
  ]
}
