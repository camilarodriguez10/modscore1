# Ningun paquete ejecuta scripts al instalarse: postinstall es la via clasica de
# un paquete comprometido para correr codigo en la maquina del desarrollador o en
# CI (plan secc. 7.1). `npm run <script>` explicito sigue funcionando.
ignore-scripts=true

# Versiones exactas: una dependencia nueva no entra con un rango abierto.
save-exact=true

audit-level=moderate
fund=false
