# Paquete portable: el .zip se versiona; la carpeta descomprimida que deja el build, no.
# GitHub rechaza archivos de mas de 100 MB (los scripts de tools/git lo revisan).
artifacts/*/

# Configuracion personal de herramientas. .claude/launch.json si se versiona.
.claude/settings.local.json
.vscode/
.idea/

# Capturas del BRD y del dashboard, e imagenes en general: documentacion interna.
# Quedan fuera del repositorio; ver docs/brd/README.md.
docs/brd/capturas/
