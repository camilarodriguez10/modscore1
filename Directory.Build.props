<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Calidad: los warnings no se acumulan, se arreglan. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>

    <!-- Todas las reglas de seguridad, no solo las recomendadas (plan secc. 7.2, SAST).
         Ojo: AnalysisModeSecurity=All no tiene efecto cuando AnalysisLevel ya trae
         modo; la forma que aplica es AnalysisLevelSecurity. La Fase 08 lo descubrio
         con un escaneo que devolvio cero hallazgos y no era cierto. -->
    <AnalysisLevelSecurity>latest-all</AnalysisLevelSecurity>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- Builds reproducibles: requisito para poder firmar y atestar la cadena de suministro. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Seguridad de dependencias (plan secc. 7.1). -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>

    <!-- Arbol de dependencias bloqueado: packages.lock.json por proyecto, y en CI
         el restore falla si alguien lo altera (plan secc. 7.1). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <WarningsNotAsErrors></WarningsNotAsErrors>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
